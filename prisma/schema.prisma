generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}
model User {
  id           String   @id @default(cuid())
  namaPengguna String
  namaToko     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  barang     Barang[]
  penjualan  Penjualan[]
}

model Barang {
  id          String   @id @default(cuid())
  userId      String
  namaBarang  String
  fotoUrl     String?
  hargaModal  Int
  hargaJual   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PenjualanItem[]

  @@index([userId])
}

model Penjualan {
  id           String   @id @default(cuid())
  userId       String
  totalHarga   Int
  uangDiterima Int
  kembalian    Int
  createdAt    DateTime @default(now())

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PenjualanItem[]

  @@index([userId])
}

model PenjualanItem {
  id                 String @id @default(cuid())
  penjualanId        String
  barangId           String
  namaBarangSnapshot String
  hargaJualSnapshot  Int
  qty                Int
  subtotal           Int

  penjualan Penjualan @relation(fields: [penjualanId], references: [id], onDelete: Cascade)
  barang    Barang    @relation(fields: [barangId], references: [id], onDelete: Restrict)

  @@index([penjualanId])
  @@index([barangId])
}